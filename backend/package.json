{
  "name": "viberater-backend",
  "version": "2.0.0",
  "description": "Backend API for viberater - Development Lifecycle Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nodemon src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "migrate": "node migrations/run.js",
    "migrate:pg-to-sqlite": "node scripts/migrate-postgres-to-sqlite.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --forceExit"
  },
  "keywords": [
    "viberater",
    "ai",
    "coding",
    "assistant",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {

    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.77.3",
    "pg": "^8.13.1",
    "better-sqlite3": "^9.2.2",
    "uuid": "^9.0.1",
    "simple-git": "^4.0.2",
    "socket.io": "^4.8.1",
    "multer": "^2.5.0",
    "knex": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "tar@6.2.1": "7.5.21",
    "form-data@4.0.5": "4.0.6",
    "body-parser@1.20.5": "1.20.9",
    "brace-expansion@1.1.14": "1.1.21",
    "brace-expansion@5.0.5": "5.0.12",
    "ws@8.18.3": "8.21.0",
    "js-yaml@3.14.2": "3.15.2",
    "browserslist@4.28.2": "4.28.7",
    "engine.io@6.6.7": "6.6.10",
    "socket.io-parser@4.2.6": "4.2.7"
  }
}
